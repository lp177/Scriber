# Scriber configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# Keys marked "editable via dashboard" can later be changed from the admin
# dashboard settings page; edits are written back to this file.

# ----------------------------------------------------------------------------
# Discord
# ----------------------------------------------------------------------------

# Discord bot token (REQUIRED). Get it from the "Bot" tab of your application
# at https://discord.com/developers/applications — keep it secret!
DISCORD_TOKEN=your-discord-bot-token

# Optional: a single Discord server (guild) ID. When set, slash commands are
# synced only to that guild, which makes them appear instantly instead of
# taking up to an hour for a global sync. Leave empty to sync globally.
DISCORD_GUILD_ID=

# ----------------------------------------------------------------------------
# Summary providers (editable via dashboard)
# The finished transcript is sent to an AI provider to generate the meeting
# summary. Providers form an ORDERED FAILOVER LIST: they are numbered with a
# _1, _2, _3 ... suffix and tried in ascending order until one succeeds. Add
# as many as you like; leave gaps out (keep the numbering contiguous).
# Each provider needs four keys:
#   SUMMARY_PROVIDER_<n>  anthropic | openai | openai-compatible
#   SUMMARY_API_KEY_<n>   the provider's API key
#   SUMMARY_MODEL_<n>     the model ID
#   SUMMARY_BASE_URL_<n>  the provider's base URL
# ----------------------------------------------------------------------------

# --- Provider 1: Anthropic (Claude) — tried first ---
SUMMARY_PROVIDER_1=anthropic
SUMMARY_API_KEY_1=sk-ant-xxxxxxxx
SUMMARY_MODEL_1=claude-opus-4-8
SUMMARY_BASE_URL_1=https://api.anthropic.com

# --- Provider 2: OpenAI (ChatGPT) — tried if provider 1 fails ---
SUMMARY_PROVIDER_2=openai
SUMMARY_API_KEY_2=sk-xxxxxxxx
SUMMARY_MODEL_2=gpt-4o
SUMMARY_BASE_URL_2=https://api.openai.com/v1

# --- Provider 3: Self-hosted OpenAI-compatible (Ollama / vLLM / LM Studio /
# LocalAI) — optional last resort; with a local provider, no data leaves your
# machine. Uncomment and adjust to enable it.
#SUMMARY_PROVIDER_3=openai-compatible
#SUMMARY_API_KEY_3=none
#SUMMARY_MODEL_3=llama3.1:8b
#SUMMARY_BASE_URL_3=http://host.docker.internal:11434/v1

# ----------------------------------------------------------------------------
# Whisper transcription (runs locally, nothing leaves the machine)
# ----------------------------------------------------------------------------

# Whisper model size: tiny / base / small / medium / large-v3 ...
# Bigger models are more accurate but slower and use more RAM.
# The model is downloaded automatically on first use. Editable via dashboard.
WHISPER_MODEL=base

# Default transcription language as a Whisper code (e.g. "en", "fr", "de",
# "es", "it", "pt", "nl", "ru", "zh", "ja") or "auto" for automatic detection.
# This is only the DEFAULT: a meeting can override it per recording with
# /scriber start lang:fr (see the README for the full list of codes).
# Editable via dashboard.
WHISPER_LANGUAGE=en

# Device to run Whisper on: "cpu" or "cuda" (NVIDIA GPU).
WHISPER_DEVICE=cpu

# Compute precision for Whisper: "int8" is fast and light on CPU;
# use "float16" on GPU.
WHISPER_COMPUTE_TYPE=int8

# ----------------------------------------------------------------------------
# Admin dashboard
# ----------------------------------------------------------------------------

# Dashboard login credentials. CHANGE THE PASSWORD before exposing the port!
# Both are editable via the dashboard settings page.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Interface and port the web server binds to.
# Keep WEB_HOST=0.0.0.0 in a container: podman/docker forward a published port
# (-p) to the container's interface, not its loopback, so 127.0.0.1 here makes
# the published port unreachable and a reverse proxy in front returns 502.
# WEB_PORT is the port INSIDE the container — leave it at 8080. To expose it on
# a different host port, change the host side of the publish mapping instead,
# e.g. -p 127.0.0.1:8885:8080, and point your reverse proxy at that host port.
WEB_HOST=0.0.0.0
WEB_PORT=8080

# HMAC key used to sign dashboard session tokens. Leave empty: a random
# secret is generated on first start and persisted to this file.
WEB_SECRET=

# ----------------------------------------------------------------------------
# Storage
# ----------------------------------------------------------------------------

# Directory for the SQLite database, transcripts and Whisper models.
# Inside the container this is /data (set by the image); on bare metal the
# default is ./data.
SCRIBER_DATA_DIR=./data
