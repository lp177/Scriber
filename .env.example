# Scriber configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# Keys marked "editable via dashboard" can later be changed from the admin
# dashboard settings page; edits are written back to this file.

# ----------------------------------------------------------------------------
# Discord
# ----------------------------------------------------------------------------

# Discord bot token (REQUIRED). Get it from the "Bot" tab of your application
# at https://discord.com/developers/applications — keep it secret!
DISCORD_TOKEN=your-discord-bot-token

# Optional: a single Discord server (guild) ID. When set, slash commands are
# synced only to that guild, which makes them appear instantly instead of
# taking up to an hour for a global sync. Leave empty to sync globally.
DISCORD_GUILD_ID=

# ----------------------------------------------------------------------------
# Summary providers (editable via dashboard)
# The finished transcript is sent to an AI provider to generate the meeting
# summary. Providers form an ORDERED FAILOVER LIST: they are numbered with a
# _1, _2, _3 ... suffix and tried in ascending order until one succeeds. Add
# as many as you like; leave gaps out (keep the numbering contiguous).
# Each provider needs four keys:
#   SUMMARY_PROVIDER_<n>  anthropic | openai | openai-compatible
#   SUMMARY_API_KEY_<n>   the provider's API key
#   SUMMARY_MODEL_<n>     the model ID
#   SUMMARY_BASE_URL_<n>  the provider's base URL
# ----------------------------------------------------------------------------

# --- Provider 1: Anthropic (Claude) — tried first ---
SUMMARY_PROVIDER_1=anthropic
SUMMARY_API_KEY_1=sk-ant-xxxxxxxx
SUMMARY_MODEL_1=claude-opus-4-8
SUMMARY_BASE_URL_1=https://api.anthropic.com

# --- Provider 2: OpenAI (ChatGPT) — tried if provider 1 fails ---
SUMMARY_PROVIDER_2=openai
SUMMARY_API_KEY_2=sk-xxxxxxxx
SUMMARY_MODEL_2=gpt-4o
SUMMARY_BASE_URL_2=https://api.openai.com/v1

# --- Provider 3: Self-hosted OpenAI-compatible (Ollama / vLLM / LM Studio /
# LocalAI) — optional last resort; with a local provider, no data leaves your
# machine. Uncomment and adjust to enable it.
#SUMMARY_PROVIDER_3=openai-compatible
#SUMMARY_API_KEY_3=none
#SUMMARY_MODEL_3=llama3.1:8b
#SUMMARY_BASE_URL_3=http://host.docker.internal:11434/v1

# ----------------------------------------------------------------------------
# Transcription
# ----------------------------------------------------------------------------

# Engine used to transcribe meetings LIVE (editable via dashboard):
#   whisper     local faster-whisper (default) — audio never leaves the machine
#   voxtral     Mistral AI cloud API   (needs VOXTRAL_API_KEY below)
#   elevenlabs  ElevenLabs Scribe API  (needs ELEVENLABS_API_KEY below)
#   google      Google Speech-to-Text  (needs GOOGLE_SPEECH_API_KEY + PROJECT)
# With a cloud engine, speech segments are sent to that service while the
# meeting runs (the recording notice says so), and Scriber automatically
# falls back to local Whisper if the cloud API fails or is unconfigured.
TRANSCRIBE_ENGINE=whisper

# Whisper model size: tiny / base / small / medium / large-v3 ...
# Bigger models are more accurate but slower and use more RAM.
# The model is downloaded automatically on first use. Editable via dashboard.
WHISPER_MODEL=base

# Default transcription language as a Whisper code (e.g. "en", "fr", "de",
# "es", "it", "pt", "nl", "ru", "zh", "ja") or "auto" for automatic detection.
# This is only the DEFAULT: a meeting can override it per recording with
# /scriber start lang:fr (see the README for the full list of codes).
# Editable via dashboard.
WHISPER_LANGUAGE=en

# Device to run Whisper on: "cpu" or "cuda" (NVIDIA GPU).
WHISPER_DEVICE=cpu

# Compute precision for Whisper: "int8" is fast and light on CPU;
# use "float16" on GPU.
WHISPER_COMPUTE_TYPE=int8

# ----------------------------------------------------------------------------
# Meeting audio (editable via dashboard)
# ----------------------------------------------------------------------------

# Keep each meeting's audio recording (data/audio/<meeting-id>.ogg). When
# enabled you can play/download the audio from the dashboard and regenerate
# the transcript with a different engine. Requires ffmpeg for compact Opus
# files (the container image ships it); without ffmpeg audio falls back to
# much larger WAV files.
AUDIO_KEEP=true

# Days after which a meeting's audio is deleted automatically. 0 = never
# expire (audio is kept forever). Transcripts and summaries are never expired.
AUDIO_RETENTION_DAYS=30

# ----------------------------------------------------------------------------
# Transcript regeneration engines (editable via dashboard, all OPTIONAL)
# When meeting audio is kept, the transcript can be regenerated from the
# dashboard with another engine to compare quality. Local Whisper needs no
# configuration (any model profile: tiny ... large-v3, large-v3-turbo). Each
# cloud engine below unlocks once its API key is set. Audio is only sent to a
# cloud engine when you explicitly regenerate with it.
# ----------------------------------------------------------------------------

# --- Voxtral (Mistral AI) ---
VOXTRAL_API_KEY=
VOXTRAL_MODEL=voxtral-mini-latest
VOXTRAL_BASE_URL=https://api.mistral.ai

# --- ElevenLabs Scribe ---
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=scribe_v2
ELEVENLABS_BASE_URL=https://api.elevenlabs.io

# --- Google Cloud Speech-to-Text v2 (Chirp) ---
# Needs an API key with Speech-to-Text access AND the Google Cloud project ID.
# GOOGLE_SPEECH_LOCATION picks the regional endpoint (eu, us, global, ...).
GOOGLE_SPEECH_API_KEY=
GOOGLE_SPEECH_PROJECT=
GOOGLE_SPEECH_LOCATION=eu
GOOGLE_SPEECH_MODEL=chirp_3

# ----------------------------------------------------------------------------
# Admin dashboard
# ----------------------------------------------------------------------------

# Dashboard login credentials. CHANGE THE PASSWORD before exposing the port!
# Both are editable via the dashboard settings page.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Interface and port the web server binds to.
# Keep WEB_HOST=0.0.0.0 in a container: podman/docker forward a published port
# (-p) to the container's interface, not its loopback, so 127.0.0.1 here makes
# the published port unreachable and a reverse proxy in front returns 502.
# WEB_PORT is the port INSIDE the container — leave it at 8080. To expose it on
# a different host port, change the host side of the publish mapping instead,
# e.g. -p 127.0.0.1:8885:8080, and point your reverse proxy at that host port.
WEB_HOST=0.0.0.0
WEB_PORT=8080

# HMAC key used to sign dashboard session tokens. Leave empty: a random
# secret is generated on first start and persisted to this file.
WEB_SECRET=

# ----------------------------------------------------------------------------
# MCP server (AI assistant access)
# ----------------------------------------------------------------------------

# Scriber can expose everything it stores (meetings, transcripts, summaries,
# participants, memories) to AI assistants over the Model Context Protocol
# (streamable HTTP at /mcp). The listener is ON by default but only reachable
# when its port is published — the compose file binds it to 127.0.0.1
# (localhost) only. Clients authenticate with an API token created in the
# dashboard (Settings -> API access): Authorization: Bearer <token>.
# Set MCP_ENABLED=false to switch the listener off entirely.
MCP_ENABLED=true

# Interface and port the MCP server binds to INSIDE the container — the same
# rules as WEB_HOST/WEB_PORT apply: keep MCP_HOST=0.0.0.0 in a container and
# choose where it is reachable with the publish mapping instead, e.g.
# -p 127.0.0.1:8081:8081.
MCP_HOST=0.0.0.0
MCP_PORT=8081

# ----------------------------------------------------------------------------
# Storage
# ----------------------------------------------------------------------------

# Directory for the SQLite database, transcripts and Whisper models.
# Inside the container this is /data (set by the image); on bare metal the
# default is ./data.
SCRIBER_DATA_DIR=./data
