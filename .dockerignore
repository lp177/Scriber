# Runtime data must never be baked into the image
data/

# Secrets stay on the host (mounted at runtime)
**/.env

# Version control
.git/

# Node / frontend build output (rebuilt inside the image)
**/node_modules/
frontend/dist/

# Python caches
**/__pycache__/
**/*.pyc
.venv/

# Documentation (not needed inside the image)
README.md

# Editor and OS junk
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
